            "title": "Metric",
            "type": "string"
          },
          "date_from": {
            "format": "date",
            "title": "Date From",
            "type": "string"
          },
          "date_to": {
            "description": "Exclusive end, ISO date; source local time with unspecified timezone",
            "format": "date",
            "title": "Date To",
            "type": "string"
          },
          "granularity": {
            "const": "month",
            "default": "month",
            "title": "Granularity",
            "type": "string"
          },
          "dataset_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Dataset Id",
            "type": "string"
          }
        },
        "required": [
          "metric",
          "date_from",
          "date_to",
          "dataset_id"
        ],
        "title": "SeriesArguments",
        "type": "object"
      }
    }
  },
