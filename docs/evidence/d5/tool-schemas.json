  {
    "type": "function",
    "function": {
      "name": "query_metric_series",
      "description": "Read exact monthly values within a left-closed right-open date interval.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Country"
          },
          "stock_code": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stock Code"
          },
          "metric": {
            "enum": [
              "positive_amount",
              "cancellation_amount",
              "net_amount",
              "positive_invoice_count"
