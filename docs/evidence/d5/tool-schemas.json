  {
    "type": "function",
    "function": {
      "name": "compare_periods",
      "description": "Compare two explicit periods; zero or negative baseline has no growth percentage.",
      "parameters": {
        "$defs": {
          "Period": {
            "additionalProperties": false,
            "properties": {
              "date_from": {
                "format": "date",
                "title": "Date From",
                "type": "string"
              },
              "date_to": {
                "description": "Exclusive end; source local date, no timezone conversion",
                "format": "date",
                "title": "Date To",
                "type": "string"
              }
            },
            "required": [
              "date_from",
              "date_to"
            ],
            "title": "Period",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "country": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Country"
          },
          "stock_code": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stock Code"
          },
          "dataset_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Dataset Id",
            "type": "string"
          },
          "metric": {
            "enum": [
              "positive_amount",
              "cancellation_amount",
              "net_amount",
              "positive_invoice_count"
            ],
            "title": "Metric",
            "type": "string"
          },
          "baseline": {
            "$ref": "#/$defs/Period"
          },
          "current": {
            "$ref": "#/$defs/Period"
          }
        },
        "required": [
          "dataset_id",
          "metric",
          "baseline",
          "current"
        ],
        "title": "CompareArguments",
        "type": "object"
      }
    }
  },
