  {
    "type": "function",
    "function": {
      "name": "get_dataset_profile",
      "description": "Read snapshot identity, source coverage and available metrics.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Dataset Id",
            "type": "string"
          }
        },
        "required": [
          "dataset_id"
        ],
        "title": "ProfileArguments",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_metric_definitions",
      "description": "Read exact metric formulas and exclusions; dataset_id optionally binds the snapshot.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "metric_names": {
            "items": {
              "enum": [
                "positive_amount",
                "cancellation_amount",
                "net_amount",
                "positive_invoice_count"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Metric Names",
            "type": "array"
          },
          "dataset_id": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z0-9_-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dataset Id"
          }
        },
        "title": "DefinitionArguments",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
