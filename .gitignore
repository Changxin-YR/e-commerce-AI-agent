# Do not commit secrets, databases, large datasets, personal annotations or private website material
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
frontend/dist/
*.sqlite
*.sqlite3
*.db
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
eval/raw/*
!eval/raw/.gitkeep
*.log
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
*.tsbuildinfo
# Local key material and all SQLite sidecars.
*.pem
*.key
*.p12
*.pfx
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
# Large source containers belong only in ignored local data/raw/.
*.xlsx
*.xls
*.zip

*.import.lock
