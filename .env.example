# Example configuration; copy to .env only in user local project; NEVER commit .env
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///D:/codex产出/电商智能体_D0工程初始化/缓存/runtime/app.sqlite3
APP_ENV=development
# Optional D0 build/test cache root. Keep task outputs under the user-selected directory.
D0_CACHE_DIR=D:/codex产出/电商智能体_D0工程初始化/缓存
# This machine's D0 database contains engineering metadata only. No trading data.
# Other installations may change this to sqlite:///./data/app.sqlite3 (relative to project root).
MODEL_PROVIDER=
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
ALLOW_PAID_MODEL_CALLS=false
MODEL_MAX_REQUESTS_PER_RUN=8
MODEL_MAX_TOOL_CALLS_PER_RUN=12
MODEL_MAX_TOTAL_REQUESTS=0
MODEL_MAX_TOTAL_TOKENS=0
MODEL_MAX_TOTAL_COST=0
EVAL_FROZEN_MODE=true
UPLOAD_MAX_BYTES=52428800

# MODEL_PROVIDER/ID/BASE_URL examples must be checked against the current provider docs and tool-call smoke, not assumed working.
# No external model requests without explicit user authorization and non-zero audited budgets.
